# ============================================================
# ACE - environment settings (copy to .env, never commit .env)
# ============================================================

# --- AI model (Anthropic Claude) ---
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 = good balance of cost/quality; claude-opus-5-5 for heavier analysis
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=4000

# --- Synology Chat (runs on the DS723+) ---
# DSM address of the Chat NAS as seen from the HP server (LAN IP, http on the LAN)
SYNOLOGY_BASE_URL=http://192.168.1.20:5000
# Chat > Integration > Bots > ACE > Token
SYNOLOGY_BOT_TOKEN=
# Optional: /ace slash command for channels
SYNOLOGY_SLASH_TOKEN=
SYNOLOGY_INCOMING_WEBHOOK_URL=
# Set false only if you use https with a self-signed NAS certificate
SYNOLOGY_VERIFY_SSL=true
# ACE's own Synology Chat *user* account on the DS723+ (v0.4: channels, files, tasks).
# Chat application only, no shared folders, no 2-step verification.
CHAT_USER=
CHAT_PASSWORD=
# Save every file shared in the channels ACE is a member of to ACE/channel-files/<Channel>/<YYYY-MM>/
CHAT_WATCH=true
CHAT_POLL_SECONDS=20
CHAT_MAX_FILE_MB=200
# Reply under each saved file with where it was saved
CHAT_REPLY_ON_SAVE=true
# Folder names for channels that have no name, e.g. 1=General;2=Random
CHAT_CHANNEL_NAMES=
# Channels ACE should ignore (ids or names, ";"-separated)
CHAT_IGNORE_CHANNELS=

# --- Files: Synology Drive NAS (AA-RS / RS1619xs+) ---
# ACE signs in over SMB as its own account and sees exactly the shared folders
# that account can read in DSM. Never use the NAS admin account here.
NAS_HOST=192.168.2.142
NAS_USER=ace
# Long random password; avoid spaces.
NAS_PASSWORD=
# ACE's own shared folder (subfolders: inbox, reports) - the only one it writes to
ACE_SHARE=ACE
# Optional: fixed list of client shares, separated by ";" - only needed if shares are
# hidden from network browsing. Empty = discover every share `ace` can read.
NAS_SHARES=
# Optional: shares never offered to users even if `ace` can read them (";"-separated)
NAS_EXCLUDE_SHARES=

# --- Network ---
ACE_PORT=8080

# --- Security ---
# Comma-separated Chat user_ids or usernames allowed to use ACE.
# Send `whoami` to the bot to see your user_id.
ALLOWED_USERS=

# --- Synology-hosted alternative only (docker-compose.synology.yml) ---
# Local read-only folders inside the container, e.g. Clients=/sources/clients
ACE_SOURCES=
PUID=1026
PGID=100

TZ=Asia/Dubai
LOG_LEVEL=INFO
