# ============================================================
# ACE - environment settings (copy to .env, never commit .env)
# ============================================================

# --- AI model (Anthropic Claude) ---
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 = good balance of cost/quality; claude-opus-5-5 for heavier analysis
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=4000

# --- Synology Chat (runs on the DS723+) ---
# DSM address of the Chat NAS as seen from the HP server (LAN IP, http on the LAN)
SYNOLOGY_BASE_URL=http://192.168.1.20:5000
# Chat > Integration > Bots > ACE > Token
SYNOLOGY_BOT_TOKEN=
# Optional: /ace slash command for channels
SYNOLOGY_SLASH_TOKEN=
SYNOLOGY_INCOMING_WEBHOOK_URL=
# Set false only if you use https with a self-signed NAS certificate
SYNOLOGY_VERIFY_SSL=true

# --- Files (Synology Drive NAS = RS1619xs+) ---
# LAN IP of the RS1619xs+ (an IP is more reliable than a name inside Docker)
NAS_IP=192.168.1.30
# The `ace` user on the RS1619xs+: READ-ONLY on client folders, READ/WRITE on ACE.
# Use letters and digits only (no , $ ; or spaces) - it goes into an SMB mount option.
NAS_USER=ace
NAS_PASSWORD=
# Shared folder with the client files (mounted read-only)
CLIENTS_SHARE=Clients
# Name users type in chat for that folder: `files Clients/Mara`
CLIENTS_SOURCE_NAME=Clients
# ACE's own shared folder (needs subfolders: inbox, reports)
ACE_SHARE=ACE

# --- Network ---
ACE_PORT=8080

# --- Security ---
# Comma-separated Chat user_ids or usernames allowed to use ACE.
# Send `whoami` to the bot to see your user_id.
ALLOWED_USERS=

# --- Synology alternative only (docker-compose.synology.yml) ---
PUID=1026
PGID=100

TZ=Asia/Dubai
LOG_LEVEL=INFO
