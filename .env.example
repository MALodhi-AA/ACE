# ============================================================
# ACE - environment settings
# Copy to .env and fill in. NEVER commit .env to GitHub.
# ============================================================

# --- AI model (Anthropic Claude) ---
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 = good balance of cost/quality; claude-opus-5-5 for heavier analysis
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=4000

# --- Synology Chat ---
# DSM address as seen from INSIDE the container (use the NAS LAN IP, not localhost)
SYNOLOGY_BASE_URL=http://192.168.1.10:5000
# Chat > Integration > Bots > (your bot) > Token
SYNOLOGY_BOT_TOKEN=
# Optional: /ace slash command for channels (old /ai still accepted)
SYNOLOGY_SLASH_TOKEN=
SYNOLOGY_INCOMING_WEBHOOK_URL=
# Set false only if you use https with a self-signed NAS certificate
SYNOLOGY_VERIFY_SSL=true

# --- Security ---
# Comma-separated Chat user_ids or usernames allowed to use the employee.
# Send `whoami` to the bot to see your user_id.
ALLOWED_USERS=

# --- Container user (Synology): run `id <your DSM user>` over SSH to find these ---
PUID=1026
PGID=100

TZ=Asia/Dubai
LOG_LEVEL=INFO
